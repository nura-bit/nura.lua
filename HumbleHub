print("🍎 HumbleHub v1.2 загружен")

local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ========== ФУНКЦИЯ ХОПА ==========

local function hop()
    print("🔄 Хоп...")
    
    -- 1. Ищем кнопку "Сервера" и кликаем
    local serverButton = nil
    for _, child in pairs(playerGui:GetDescendants()) do
        if child:IsA("TextButton") or child:IsA("ImageButton") then
            local hasText, text = pcall(function() return child.Text end)
            if hasText and type(text) == "string" then
                if string.find(text, "Server") or string.find(text, "Сервер") or string.find(text, "Сервера") then
                    serverButton = child
                    break
                end
            end
        end
    end

    if not serverButton then
        print("❌ Кнопка 'Сервера' не найдена, перезапуск...")
        game:Shutdown()
        return
    end

    serverButton:Click()
    print("✅ Меню открыто")
    wait(1.5) -- ждём загрузки списка

    -- 2. Ищем все кнопки "Join" и кликаем по случайной
    local joinButtons = {}
    for _, child in pairs(playerGui:GetDescendants()) do
        if child:IsA("TextButton") and child.Visible then
            local hasText, text = pcall(function() return child.Text end)
            if hasText and type(text) == "string" then
                if string.find(text, "Join") or string.find(text, "Играть") or string.find(text, "Присоединиться") then
                    table.insert(joinButtons, child)
                end
            end
        end
    end

    if #joinButtons == 0 then
        print("❌ Кнопки 'Join' не найдены, перезапуск...")
        game:Shutdown()
        return
    end

    local selected = joinButtons[math.random(1, #joinButtons)]
    print("✅ Нажатие на Join...")
    selected:Click()
    wait(0.5)

    -- Дополнительный клик через координаты
    pcall(function()
        local pos = selected.AbsolutePosition
        local size = selected.AbsoluteSize
        if pos and size then
            mouse1click(pos.X + size.X/2, pos.Y + size.Y/2)
        end
    end)

    print("✅ Хоп выполнен!")
end

