print("🍎 HumbleHub v2.0 загружен")

local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Workspace = game:GetService("Workspace")

local TOLERANCE = 30 -- допуск в секундах (подходит, если остаток до часа меньше 30 или больше 3570)

-- ========== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ==========

-- Эмуляция клика по кнопке (с запасным вариантом)
local function clickButton(button)
    if not button then return false end
    pcall(function() button:Click() end)
    pcall(function()
        local pos = button.AbsolutePosition
        local size = button.AbsoluteSize
        if pos and size then
            mouse1click(pos.X + size.X/2, pos.Y + size.Y/2)
        end
    end)
    return true
end

-- Поиск кнопки по тексту (регистронезависимо)
local function findButtonByText(keywords)
    for _, child in pairs(playerGui:GetDescendants()) do
        if child:IsA("TextButton") or child:IsA("ImageButton") then
            local success, text = pcall(function() return child.Text end)
            if success and type(text) == "string" then
                local lower = string.lower(text)
                for _, kw in ipairs(keywords) do
                    if string.find(lower, string.lower(kw)) then
                        return child
                    end
                end
            end
        end
    end
    return nil
end

-- ========== ГЛАВНАЯ ФУНКЦИЯ ХОПА (GUI) ==========

local function hopViaGUI()
    print("🔄 Хоп через GUI...")

    -- 1. Открыть меню серверов
    local serverButton = findButtonByText({"server", "сервер", "servers"})
    if not serverButton then
        print("❌ Кнопка 'Сервера' не найдена")
        return false
    end

    clickButton(serverButton)
    print("✅ Меню открыто, ждём загрузки...")
    wait(1.5)

    -- 2. Найти и нажать кнопку "Join"
    local joinButton = findButtonByText({"join", "играть", "присоединиться"})
    if not joinButton then
        print("❌ Кнопка 'Join' не найдена")
        return false
    end

    clickButton(joinButton)
    print("✅ Клик по Join выполнен")
    return true
end

-- ========== ПРОВЕРКА АПТАЙМА И УМНЫЙ ХОП ==========

local function smartHop()
    local uptime = Workspace.DistributedGameTime
    local remainder = uptime % 3600
    local isGood = (remainder <= TOLERANCE) or (remainder >= (3600 - TOLERANCE))

    print(string.format("🕐 Аптайм сервера: %d сек (%.1f мин), остаток до часа: %d сек", uptime, uptime/60, remainder))

    if isGood then
        print("✅ Аптайм подходит! Остаёмся на сервере.")
        return
    end

    print("⏳ Аптайм не подходит, делаем хоп...")
    local success = hopViaGUI()
    if success then
        print("✅ Хоп выполнен успешно!")
    else
        print("❌ Хоп не удался. Попробуй вручную.")
    end
end

