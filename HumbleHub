-- ========== HTTP-ЗАПРОСЫ ==========

local function httpGet(url)
    local success, result = pcall(function() return http.request({ Url = url, Method = "GET" }) end)
    if success and result then return result.Body end
    local success2, result2 = pcall(function() return syn.request({ Url = url, Method = "GET" }) end)
    if success2 and result2 then return result2.Body end
    local success3, result3 = pcall(function() return game:HttpGet(url) end)
    if success3 and result3 then return result3 end
    return nil
end

-- ========== ПОЛУЧЕНИЕ СПИСКА СЕРВЕРОВ ==========

local function getServers()
    local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?limit=100"
    local response = httpGet(url)
    if not response then
        print("❌ Не удалось получить список серверов")
        return nil
    end
    local success, data = pcall(function()
        return HttpService:JSONDecode(response)
    end)
    if not success or not data or not data.data then
        print("❌ Ошибка парсинга")
        return nil
    end
    return data.data
end

-- ========== ПОИСК КНОПКИ "JOIN" ДЛЯ КОНКРЕТНОГО СЕРВЕРА ==========

local function findJoinButtonForServer(serverId)
    -- Ищем в PlayerGui элемент с текстом, содержащим serverId или имя сервера
    -- В меню серверов обычно есть список, и у каждого сервера есть кнопка "Join"
    local playerGui = player:WaitForChild("PlayerGui")
    local joinButton = nil

    local function searchForJoin(parent)
        for _, child in pairs(parent:GetChildren()) do
            -- Проверяем, является ли элемент кнопкой с текстом Join/Присоединиться
            if child:IsA("TextButton") then
                local hasText, text = pcall(function() return child.Text end)
                if hasText and type(text) == "string" then
                    if string.find(text, "Join") or string.find(text, "Играть") or string.find(text, "Присоединиться") then
                        -- Проверяем, есть ли рядом текст с serverId (может быть в родителе или соседях)
                        local parentContainer = child.Parent
                        if parentContainer then
                            for _, sibling in pairs(parentContainer:GetChildren()) do
                                local hasSibText, sibText = pcall(function() return sibling.Text end)
                                if hasSibText and type(sibText) == "string" then
                                    if string.find(sibText, serverId) then
                                        return child
                                    end
                                end
                            end
                        end
                    end
                end
            end
            -- Рекурсивный обход
            local found = searchForJoin(child)
            if found then return found end
        end
        return nil
    end

    joinButton = searchForJoin(playerGui)
    return joinButton
end

-- ========== ОТКРЫТИЕ МЕНЮ СЕРВЕРОВ ==========

local function openServerMenu()
    local playerGui = player:WaitForChild("PlayerGui")
    for _, child in pairs(playerGui:GetDescendants()) do
        if child:IsA("TextButton") or child:IsA("ImageButton") then
            local hasText, text = pcall(function() return child.Text end)
            if hasText and type(text) == "string" then
                if string.find(text, "Server") or string.find(text, "Сервер") or string.find(text, "Сервера") then
                    child:Click()
                    return true
                end
            end
        end
    end
    return false
end

-- ========== ОСНОВНАЯ ФУНКЦИЯ ХОПА ==========

local function hopToLeastPopulatedServer()
    print("🔄 Хоп на сервер с наименьшим количеством игроков...")

    -- 1. Получаем список серверов
    local servers = getServers()
    if not servers or #servers == 0 then
        print("❌ Не удалось получить список серверов")
        return
    end

    -- 2. Сортируем по количеству игроков (по возрастанию)
    table.sort(servers, function(a, b)
        return (a.playing or 0) < (b.playing or 0)
    end)

    -- 3. Ищем сервер с игроками меньше максимума (не полный)
    local targetServer = nil
    local currentJobId = game.JobId
    for _, server in pairs(servers) do
        if server.id ~= currentJobId and (server.playing or 0) < (server.maxPlayers or 12) then
            targetServer = server
            break
        end
    end

    if not targetServer then
        print("❌ Не найдено подходящих серверов")
        return
    end

    local serverId = targetServer.id
    local playerCount = targetServer.playing or 0
    print("✅ Выбран сервер с " .. playerCount .. " игроками")

    -- 4. Открываем меню серверов
    if not openServerMenu() then
        print("❌ Не удалось открыть меню серверов")
        return
    end

    wait(1.5) -- ждём загрузки списка

    -- 5. Ищем кнопку Join для этого сервера
    local joinButton = findJoinButtonForServer(serverId)
    if not joinButton then
        print("❌ Не найдена кнопка Join для сервера " .. serverId)
        return
    end

    -- 6. Кликаем по Join
    print("✅ Нажатие на Join...")
    joinButton:Click()
    wait(0.5)

    -- Дополнительный клик через координаты (на всякий случай)
    pcall(function()
        local pos = joinButton.AbsolutePosition
        local size = joinButton.AbsoluteSize
        if pos and size then
            mouse1click(pos.X + size.X/2, pos.Y + size.Y/2)
        end
    end)

    print("✅ Хоп выполнен!")
end

