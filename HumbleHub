-- ========== ГЛАВНАЯ ФУНКЦИЯ ХОПА ==========

local function hop()
    print("🔄 Хоп...")

    -- Ищем кнопку "ServerHop"
    local serverHopButton = nil
    for _, child in pairs(playerGui:GetDescendants()) do
        if child:IsA("TextButton") and child.Name == "ServerHop" then
            serverHopButton = child
            break
        end
    end

    if serverHopButton then
        print("✅ Найдена кнопка ServerHop, клик...")
        serverHopButton:Click()
        wait(0.5)
        -- Дополнительный клик через координаты для надёжности
        pcall(function()
            local pos = serverHopButton.AbsolutePosition
            local size = serverHopButton.AbsoluteSize
            if pos and size then
                mouse1click(pos.X + size.X/2, pos.Y + size.Y/2)
            end
        end)
        print("✅ Клик выполнен.")
    else
        print("❌ Кнопка ServerHop не найдена. Сообщите разработчику.")
        -- Никакого перезапуска!
    end
end

