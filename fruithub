-- =============================================
--  BLOX HUB v5.6 (Отображение возраста сервера)
-- =============================================

print("1. Скрипт начал выполнение")

local Player = game.Players.LocalPlayer
if not Player then
    print("Ошибка: Player не найден")
    return
end
print("2. Player найден")

local function Notify(text)
    print(text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Fruit Hub",
            Text = text,
            Duration = 3
        })
    end)
end

local guiParent = Player:WaitForChild("PlayerGui")
if not guiParent then
    print("Ошибка: PlayerGui не найден")
    return
end
print("Используем PlayerGui")

wait(1)
print("3. Начинаем создание GUI")

local createSuccess, createErr = pcall(function()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "FruitHubGUI"
    screenGui.Parent = guiParent
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true
    print("3.1 ScreenGui создан")

    -- Круглая кнопка-логотип
    local toggleButton = Instance.new("ImageButton")
    toggleButton.Name = "ToggleButton"
    toggleButton.Parent = screenGui
    toggleButton.Size = UDim2.new(0, 70, 0, 70)
    toggleButton.Position = UDim2.new(0, 15, 0, 100)
    toggleButton.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
    toggleButton.BackgroundTransparency = 0
    toggleButton.Image = "rbxassetid://1234567890"
    toggleButton.ImageTransparency = 1
    local corner = Instance.new("UICorner")
    corner.Parent = toggleButton
    corner.CornerRadius = UDim.new(1, 0)

    local label = Instance.new("TextLabel")
    label.Parent = toggleButton
    label.Size = UDim2.new(1, 0, 1, 0)
    label.Text = "🍎"
    label.TextScaled = true
    label.TextColor3 = Color3.fromRGB(0, 0, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.SourceSansBold
    print("4. Кнопка создана")

    -- Главное меню
    local MainFrame = Instance.new("Frame")
    MainFrame.Parent = screenGui
    MainFrame.Size = UDim2.new(0, 380, 0, 320)
    MainFrame.Position = UDim2.new(0.5, -190, 0.5, -160)
    MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 35)
    MainFrame.BackgroundTransparency = 0.1
    MainFrame.Active = true
    MainFrame.Draggable = true
    MainFrame.Visible = false

    local cornerMain = Instance.new("UICorner")
    cornerMain.Parent = MainFrame
    cornerMain.CornerRadius = UDim.new(0, 16)

    local Title = Instance.new("TextLabel")
    Title.Parent = MainFrame
    Title.Size = UDim2.new(1, 0, 0, 40)
    Title.Text = "🍎 Fruit Hub v5.6"
    Title.TextColor3 = Color3.fromRGB(255, 215, 0)
    Title.BackgroundTransparency = 1
    Title.Font = Enum.Font.SourceSansBold
    Title.TextSize = 22

    local TabContainer = Instance.new("Frame")
    TabContainer.Parent = MainFrame
    TabContainer.Size = UDim2.new(1, -20, 1, -55)
    TabContainer.Position = UDim2.new(0, 10, 0, 45)
    TabContainer.BackgroundTransparency = 1
    print("5. Меню создано")

    local function AddButton(parent, text, callback, color)
        local btn = Instance.new("TextButton")
        btn.Parent = parent
        btn.Size = UDim2.new(1, 0, 0, 40)
        local count = #parent:GetChildren()
        btn.Position = UDim2.new(0, 0, 0, count * 44 + 5)
        btn.Text = text
        btn.BackgroundColor3 = color or Color3.fromRGB(60, 60, 85)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.SourceSans
        btn.TextSize = 17
        btn.BorderSizePixel = 0
        btn.BackgroundTransparency = 0.2
        local cornerBtn = Instance.new("UICorner")
        cornerBtn.Parent = btn
        cornerBtn.CornerRadius = UDim.new(0, 8)
        btn.MouseButton1Click:Connect(callback)
    end

    -- ========== ПОИСК ВРЕМЕНИ СТАРТА СЕРВЕРА ==========

    local serverStartTime = nil

    local function findServerStartTime()
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local foundTime = nil

        -- 1. Ищем в RemoteEvent
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent") then
                obj.OnClientEvent:Connect(function(...)
                    local args = {...}
                    for _, arg in ipairs(args) do
                        if type(arg) == "number" and arg > 1e9 then
                            if not serverStartTime then
                                serverStartTime = arg
                                print("Время старта (из RemoteEvent):", os.date("%H:%M:%S", serverStartTime))
                                Notify("Время старта получено!")
                            end
                            return
                        end
                    end
                end)
            end
        end

        -- 2. Ищем в IntValue / NumberValue
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("IntValue") or obj:IsA("NumberValue") then
                if type(obj.Value) == "number" and obj.Value > 1e9 then
                    if not serverStartTime then
                        serverStartTime = obj.Value
                        print("Время старта (из Value):", os.date("%H:%M:%S", serverStartTime))
                        Notify("Время старта получено!")
                    end
                    return
                end
            end
        end

        -- 3. Если ничего не нашли, используем DistributedGameTime
        if not serverStartTime then
            local now = os.time()
            local age = workspace.DistributedGameTime
            if age > 0 then
                serverStartTime = now - age
                print("Время старта (приблизительно):", os.date("%H:%M:%S", serverStartTime))
                Notify("Время старта оценено (приблизительно)")
            end
        end

        return serverStartTime
    end

    -- ========== ФУНКЦИЯ ДЛЯ ОТОБРАЖЕНИЯ ВОЗРАСТА ==========

    local function showServerAge()
        if not serverStartTime then
            Notify("⏳ Получаем время старта...")
            findServerStartTime()
            wait(2)
            if not serverStartTime then
                Notify("❌ Не удалось определить возраст")
                return
            end
        end

        local currentTime = os.time()
        local age = currentTime - serverStartTime
        local hours = math.floor(age / 3600)
        local minutes = math.floor((age % 3600) / 60)
        local seconds = math.floor(age % 60)

        local ageStr = string.format("%02d:%02d:%02d", hours, minutes, seconds)
        Notify("🕐 Возраст сервера: " .. ageStr)
        print("Возраст сервера:", ageStr)
    end

    -- ========== СЕРВЕР-ХОП ПО ВРЕМЕНИ ==========

    local function hopToFreshServer()
        if not serverStartTime then
            Notify("⏳ Ждём получения времени старта...")
            findServerStartTime()
            wait(2)
            if not serverStartTime then
                Notify("❌ Не удалось получить время. Перезапуск...")
                game:Shutdown()
                return
            end
        end

        local currentTime = os.time()
        local age = currentTime - serverStartTime
        local minutes = math.floor((age % 3600) / 60)

        if minutes >= 0 and minutes <= 2 then
            Notify("✅ Сервер свежий (" .. minutes .. " мин)")
            return
        else
            Notify("⏳ Возраст " .. minutes .. " мин. Переключаем...")
            -- Пытаемся через меню
            pcall(function()
                game:GetService("GuiService"):OpenPlayerMenu()
            end)
            wait(1)
            local coreGui = game:GetService("CoreGui")
            local playButton = nil
            for _, child in pairs(coreGui:GetDescendants()) do
                if child:IsA("TextButton") and string.find(child.Name, "Play") then
                    playButton = child
                    break
                end
            end
            if playButton then
                pcall(function() playButton:Click() end)
            else
                game:Shutdown()
            end
        end
    end

    -- ========== КНОПКИ ==========
    AddButton(TabContainer, "🕐 Показать возраст сервера", showServerAge, Color3.fromRGB(70, 130, 180))
    AddButton(TabContainer, "🔄 Хоп на свежий сервер (0-2 мин)", hopToFreshServer, Color3.fromRGB(0, 200, 100))
    AddButton(TabContainer, "🔄 Перезапустить игру (запасной)", function() game:Shutdown() end, Color3.fromRGB(200, 50, 50))

    print("6. Кнопки добавлены")

    local menuVisible = false
    toggleButton.MouseButton1Click:Connect(function()
        menuVisible = not menuVisible
        MainFrame.Visible = menuVisible
        print("Клик по кнопке, меню видимо =", menuVisible)
    end)

    print("7. Обработчик клика установлен")
end)

if not createSuccess then
    print("Ошибка при создании GUI:", createErr)
else
    print("✅ Fruit Hub v5.6 загружен! Нажми на 🍎")
end
