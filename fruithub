-- =============================================
--  BLOX HUB v8.2 (Правильный хоп через меню)
-- =============================================

print("1. Скрипт начал выполнение")

local Player = game.Players.LocalPlayer
if not Player then
    print("Ошибка: Player не найден")
    return
end
print("2. Player найден")

local function Notify(text)
    print(text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Fruit Hub",
            Text = text,
            Duration = 3
        })
    end)
end

local guiParent = Player:WaitForChild("PlayerGui")
if not guiParent then
    print("Ошибка: PlayerGui не найден")
    return
end
print("Используем PlayerGui")

wait(1)
print("3. Начинаем создание GUI")

local createSuccess, createErr = pcall(function()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "FruitHubGUI"
    screenGui.Parent = guiParent
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true
    print("3.1 ScreenGui создан")

    local toggleButton = Instance.new("ImageButton")
    toggleButton.Name = "ToggleButton"
    toggleButton.Parent = screenGui
    toggleButton.Size = UDim2.new(0, 70, 0, 70)
    toggleButton.Position = UDim2.new(0, 15, 0, 100)
    toggleButton.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
    toggleButton.BackgroundTransparency = 0
    toggleButton.Image = "rbxassetid://1234567890"
    toggleButton.ImageTransparency = 1
    local corner = Instance.new("UICorner")
    corner.Parent = toggleButton
    corner.CornerRadius = UDim.new(1, 0)

    local label = Instance.new("TextLabel")
    label.Parent = toggleButton
    label.Size = UDim2.new(1, 0, 1, 0)
    label.Text = "🍎"
    label.TextScaled = true
    label.TextColor3 = Color3.fromRGB(0, 0, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.SourceSansBold
    print("4. Кнопка создана")

    local MainFrame = Instance.new("Frame")
    MainFrame.Parent = screenGui
    MainFrame.Size = UDim2.new(0, 380, 0, 200)
    MainFrame.Position = UDim2.new(0.5, -190, 0.5, -100)
    MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 35)
    MainFrame.BackgroundTransparency = 0.1
    MainFrame.Active = true
    MainFrame.Draggable = true
    MainFrame.Visible = false

    local cornerMain = Instance.new("UICorner")
    cornerMain.Parent = MainFrame
    cornerMain.CornerRadius = UDim.new(0, 16)

    local Title = Instance.new("TextLabel")
    Title.Parent = MainFrame
    Title.Size = UDim2.new(1, 0, 0, 40)
    Title.Text = "🍎 Fruit Hub v8.2 (Хоп через меню)"
    Title.TextColor3 = Color3.fromRGB(255, 215, 0)
    Title.BackgroundTransparency = 1
    Title.Font = Enum.Font.SourceSansBold
    Title.TextSize = 22

    local TabContainer = Instance.new("Frame")
    TabContainer.Parent = MainFrame
    TabContainer.Size = UDim2.new(1, -20, 1, -55)
    TabContainer.Position = UDim2.new(0, 10, 0, 45)
    TabContainer.BackgroundTransparency = 1
    print("5. Меню создано")

    local function AddButton(parent, text, callback, color)
        local btn = Instance.new("TextButton")
        btn.Parent = parent
        btn.Size = UDim2.new(1, 0, 0, 40)
        local count = #parent:GetChildren()
        btn.Position = UDim2.new(0, 0, 0, count * 44 + 5)
        btn.Text = text
        btn.BackgroundColor3 = color or Color3.fromRGB(60, 60, 85)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.SourceSans
        btn.TextSize = 17
        btn.BorderSizePixel = 0
        btn.BackgroundTransparency = 0.2
        local cornerBtn = Instance.new("UICorner")
        cornerBtn.Parent = btn
        cornerBtn.CornerRadius = UDim.new(0, 8)
        btn.MouseButton1Click:Connect(callback)
    end

    -- ========== ХОП ЧЕРЕЗ МЕНЮ ==========

    local function hopThroughMenu()
        Notify("🔄 Начинаю хоп через меню...")

        -- 1. Ищем кнопку "Сервера" в правом верхнем углу
        local playerGui = Player:WaitForChild("PlayerGui")
        local serverButton = nil

        for _, child in pairs(playerGui:GetDescendants()) do
            if child:IsA("TextButton") or child:IsA("ImageButton") then
                local hasText, text = pcall(function() return child.Text end)
                if hasText and type(text) == "string" then
                    if string.find(text, "Server") or string.find(text, "Сервер") or string.find(text, "Сервера") then
                        serverButton = child
                        break
                    end
                end
            end
        end

        if not serverButton then
            Notify("❌ Кнопка 'Сервера' не найдена")
            return
        end

        -- 2. Кликаем по кнопке "Сервера"
        pcall(function() serverButton:Click() end)
        Notify("✅ Открываю меню серверов...")
        wait(1.5) -- ждём загрузки списка

        -- 3. Ищем в списке серверов название сервера (любого)
        local serverNameObjects = {}
        for _, child in pairs(playerGui:GetDescendants()) do
            if child:IsA("TextLabel") or child:IsA("TextButton") then
                local hasText, text = pcall(function() return child.Text end)
                if hasText and type(text) == "string" and text ~= "" then
                    -- Ищем строки, похожие на название сервера
                    if string.find(text, "Server") or string.find(text, "Сервер") or string.find(text, "#") then
                        table.insert(serverNameObjects, child)
                    end
                end
            end
        end

        if #serverNameObjects == 0 then
            Notify("❌ Не найдено названий серверов в меню")
            return
        end

        -- 4. Выбираем случайный сервер из списка
        local randomIndex = math.random(1, #serverNameObjects)
        local serverNameObject = serverNameObjects[randomIndex]
        Notify("✅ Выбираю сервер: " .. serverNameObject.Text)
        pcall(function() serverNameObject:Click() end) -- кликаем по названию сервера

        wait(1)

        -- 5. Ищем кнопку "Join" или "Присоединиться" рядом с выбранным сервером
        local joinButton = nil
        local parent = serverNameObject.Parent
        for i = 1, 10 do -- поднимаемся до 10 уровней вверх
            if not parent then break end
            for _, child in pairs(parent:GetDescendants()) do
                if child:IsA("TextButton") or child:IsA("ImageButton") then
                    local hasText, text = pcall(function() return child.Text end)
                    if hasText and type(text) == "string" then
                        if string.find(text, "Join") or string.find(text, "Присоединиться") then
                            joinButton = child
                            break
                        end
                    end
                end
            end
            if joinButton then break end
            parent = parent.Parent
        end

        if not joinButton then
            Notify("❌ Кнопка 'Join' не найдена")
            return
        end

        -- 6. Кликаем по "Join"
        Notify("✅ Кликаю по Join...")
        pcall(function() joinButton:Click() end)
        wait(0.5)

        -- Дополнительный клик через координаты
        pcall(function()
            local pos = joinButton.AbsolutePosition
            local size = joinButton.AbsoluteSize
            if pos and size then
                mouse1click(pos.X + size.X/2, pos.Y + size.Y/2)
            end
        end)

        Notify("✅ Хоп выполнен!")
    end

    -- ========== КНОПКИ ==========
    AddButton(TabContainer, "🔄 Сервер-хоп (через меню)", hopThroughMenu, Color3.fromRGB(0, 200, 100))
    AddButton(TabContainer, "🔄 Перезапустить игру", function() game:Shutdown() end, Color3.fromRGB(200, 50, 50))

    print("6. Кнопки добавлены")

    local menuVisible = false
    toggleButton.MouseButton1Click:Connect(function()
        menuVisible = not menuVisible
        MainFrame.Visible = menuVisible
        print("Клик по кнопке, меню видимо =", menuVisible)
    end)

    print("7. Обработчик клика установлен")
end)

if not createSuccess then
    print("Ошибка при создании GUI:", createErr)
else
    print("✅ Fruit Hub v8.2 загружен! Нажми на 🍎")
end
