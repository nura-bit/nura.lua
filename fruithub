-- =============================================
--  BLOX HUB v5.2 (Авто-фрукт + автопереключение)
-- =============================================

print("1. Скрипт начал выполнение")

local Player = game.Players.LocalPlayer
if not Player then
    print("Ошибка: Player не найден")
    return
end
print("2. Player найден")

local function Notify(text)
    print(text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Fruit Hub",
            Text = text,
            Duration = 2
        })
    end)
end

local guiParent = Player:WaitForChild("PlayerGui")
if not guiParent then
    print("Ошибка: PlayerGui не найден")
    return
end
print("Используем PlayerGui")

wait(1)
print("3. Начинаем создание GUI")

local createSuccess, createErr = pcall(function()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "FruitHubGUI"
    screenGui.Parent = guiParent
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true
    print("3.1 ScreenGui создан")

    -- Круглая кнопка-логотип
    local toggleButton = Instance.new("ImageButton")
    toggleButton.Name = "ToggleButton"
    toggleButton.Parent = screenGui
    toggleButton.Size = UDim2.new(0, 70, 0, 70)
    toggleButton.Position = UDim2.new(0, 15, 0, 100)
    toggleButton.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
    toggleButton.BackgroundTransparency = 0
    toggleButton.Image = "rbxassetid://1234567890"
    toggleButton.ImageTransparency = 1
    local corner = Instance.new("UICorner")
    corner.Parent = toggleButton
    corner.CornerRadius = UDim.new(1, 0)

    local label = Instance.new("TextLabel")
    label.Parent = toggleButton
    label.Size = UDim2.new(1, 0, 1, 0)
    label.Text = "🍎"
    label.TextScaled = true
    label.TextColor3 = Color3.fromRGB(0, 0, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.SourceSansBold
    print("4. Кнопка создана")

    -- Главное меню
    local MainFrame = Instance.new("Frame")
    MainFrame.Parent = screenGui
    MainFrame.Size = UDim2.new(0, 380, 0, 220)
    MainFrame.Position = UDim2.new(0.5, -190, 0.5, -110)
    MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 35)
    MainFrame.BackgroundTransparency = 0.1
    MainFrame.Active = true
    MainFrame.Draggable = true
    MainFrame.Visible = false

    local cornerMain = Instance.new("UICorner")
    cornerMain.Parent = MainFrame
    cornerMain.CornerRadius = UDim.new(0, 16)

    local Title = Instance.new("TextLabel")
    Title.Parent = MainFrame
    Title.Size = UDim2.new(1, 0, 0, 40)
    Title.Text = "🍎 Fruit Hub v5.2"
    Title.TextColor3 = Color3.fromRGB(255, 215, 0)
    Title.BackgroundTransparency = 1
    Title.Font = Enum.Font.SourceSansBold
    Title.TextSize = 22

    local TabContainer = Instance.new("Frame")
    TabContainer.Parent = MainFrame
    TabContainer.Size = UDim2.new(1, -20, 1, -55)
    TabContainer.Position = UDim2.new(0, 10, 0, 45)
    TabContainer.BackgroundTransparency = 1
    print("5. Меню создано")

    local function AddButton(parent, text, callback, color)
        local btn = Instance.new("TextButton")
        btn.Parent = parent
        btn.Size = UDim2.new(1, 0, 0, 40)
        local count = #parent:GetChildren()
        btn.Position = UDim2.new(0, 0, 0, count * 44 + 5)
        btn.Text = text
        btn.BackgroundColor3 = color or Color3.fromRGB(60, 60, 85)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.SourceSans
        btn.TextSize = 17
        btn.BorderSizePixel = 0
        btn.BackgroundTransparency = 0.2
        local cornerBtn = Instance.new("UICorner")
        cornerBtn.Parent = btn
        cornerBtn.CornerRadius = UDim.new(0, 8)
        btn.MouseButton1Click:Connect(callback)
    end

    -- ========== ФУНКЦИИ ==========

    -- Список фруктов
    local fruitNames = {"Fruit", "Apple", "Banana", "Gravity", "Flame", "Light", "Dark", "Water", "Ice", "Quake", "Dragon", "Soul", "Venom", "Dough", "Shadow", "Leopard", "Blizzard", "Kilo", "Spin", "Rubber", "Falcon", "Smoke", "Ghost", "Sand", "Magma", "Buddha", "Portal", "Rumble", "String", "Diamond", "Flower", "Control", "Pain", "Love", "Spider", "Paw"}

    local function findFruits()
        local fruits = {}
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Part") or v:IsA("Model") then
                local name = v.Name
                for _, fname in pairs(fruitNames) do
                    if string.find(name, fname) or string.find(string.lower(name), string.lower(fname)) then
                        if v:FindFirstChild("Handle") or v:FindFirstChild("Mesh") or v:FindFirstChild("BasePart") then
                            table.insert(fruits, v)
                            break
                        end
                    end
                end
            end
        end
        return fruits
    end

    -- Телепорт к фрукту
    local function teleportToFruit(fruit)
        local char = Player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local pos = fruit:FindFirstChild("Handle") and fruit.Handle.Position or fruit.Position
        if pos then
            hrp.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0))
        end
    end

    -- Сервер-хоп (без проверки времени)
    local function hopToRandomServer()
        Notify("🔄 Переключение сервера...")
        game:GetService("TeleportService"):Teleport(game.PlaceId, Player)
        -- Если не сработает, перезапуск
        wait(2)
        game:Shutdown()
    end

    -- ========== ГЛАВНЫЙ ЦИКЛ АВТО-ФРУКТА ==========

    local autoFruitRunning = false
    local autoFruitThread = nil

    local function startAutoFruit()
        if autoFruitRunning then
            Notify("⏳ Уже запущен")
            return
        end
        autoFruitRunning = true
        Notify("🔁 Авто-фрукт запущен")

        autoFruitThread = coroutine.create(function()
            while autoFruitRunning do
                Notify("🔍 Ищем фрукты на сервере...")
                local fruits = findFruits()
                if #fruits > 0 then
                    local nearest = nil
                    local distMin = math.huge
                    local char = Player.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        for _, fruit in pairs(fruits) do
                            local pos = fruit:FindFirstChild("Handle") and fruit.Handle.Position or fruit.Position
                            if pos then
                                local dist = (pos - hrp.Position).Magnitude
                                if dist < distMin then
                                    distMin = dist
                                    nearest = fruit
                                end
                            end
                        end
                    end
                    if nearest then
                        Notify("🍎 Фрукт найден! Телепорт...")
                        teleportToFruit(nearest)
                        wait(2) -- ждём, чтобы автоподбор сработал
                    end
                else
                    Notify("❌ Фруктов нет. Хоп...")
                end
                -- Переключение на новый сервер
                hopToRandomServer()
                wait(5) -- пауза перед следующим циклом (на случай, если телепорт не сработает)
            end
            Notify("⛔ Авто-фрукт остановлен")
        end)
        coroutine.resume(autoFruitThread)
    end

    local function stopAutoFruit()
        if autoFruitRunning then
            autoFruitRunning = false
            Notify("⛔ Остановка...")
        else
            Notify("ℹ️ Авто-фрукт не запущен")
        end
    end

    -- ========== КНОПКИ ==========
    AddButton(TabContainer, "🔁 Авто-фрукт (бесконечно)", startAutoFruit, Color3.fromRGB(0, 200, 100))
    AddButton(TabContainer, "⏹️ Остановить", stopAutoFruit, Color3.fromRGB(200, 50, 50))

    print("6. Кнопки добавлены")

    local menuVisible = false
    toggleButton.MouseButton1Click:Connect(function()
        menuVisible = not menuVisible
        MainFrame.Visible = menuVisible
        print("Клик по кнопке, меню видимо =", menuVisible)
    end)

    print("7. Обработчик клика установлен")
end)

if not createSuccess then
    print("Ошибка при создании GUI:", createErr)
else
    print("✅ Fruit Hub v5.2 загружен! Нажми на 🍎")
end
