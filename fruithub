-- =============================================
--  BLOX HUB v7.8 (Клик по конкретному серверу)
-- =============================================

print("1. Скрипт начал выполнение")

local Player = game.Players.LocalPlayer
if not Player then
    print("Ошибка: Player не найден")
    return
end
print("2. Player найден")

local function Notify(text)
    print(text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Fruit Hub",
            Text = text,
            Duration = 3
        })
    end)
end

local guiParent = Player:WaitForChild("PlayerGui")
if not guiParent then
    print("Ошибка: PlayerGui не найден")
    return
end
print("Используем PlayerGui")

wait(1)
print("3. Начинаем создание GUI")

local createSuccess, createErr = pcall(function()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "FruitHubGUI"
    screenGui.Parent = guiParent
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true
    print("3.1 ScreenGui создан")

    local toggleButton = Instance.new("ImageButton")
    toggleButton.Name = "ToggleButton"
    toggleButton.Parent = screenGui
    toggleButton.Size = UDim2.new(0, 70, 0, 70)
    toggleButton.Position = UDim2.new(0, 15, 0, 100)
    toggleButton.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
    toggleButton.BackgroundTransparency = 0
    toggleButton.Image = "rbxassetid://1234567890"
    toggleButton.ImageTransparency = 1
    local corner = Instance.new("UICorner")
    corner.Parent = toggleButton
    corner.CornerRadius = UDim.new(1, 0)

    local label = Instance.new("TextLabel")
    label.Parent = toggleButton
    label.Size = UDim2.new(1, 0, 1, 0)
    label.Text = "🍎"
    label.TextScaled = true
    label.TextColor3 = Color3.fromRGB(0, 0, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.SourceSansBold
    print("4. Кнопка создана")

    local MainFrame = Instance.new("Frame")
    MainFrame.Parent = screenGui
    MainFrame.Size = UDim2.new(0, 420, 0, 620)
    MainFrame.Position = UDim2.new(0.5, -210, 0.5, -310)
    MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 35)
    MainFrame.BackgroundTransparency = 0.1
    MainFrame.Active = true
    MainFrame.Draggable = true
    MainFrame.Visible = false

    local cornerMain = Instance.new("UICorner")
    cornerMain.Parent = MainFrame
    cornerMain.CornerRadius = UDim.new(0, 16)

    local Title = Instance.new("TextLabel")
    Title.Parent = MainFrame
    Title.Size = UDim2.new(1, 0, 0, 40)
    Title.Text = "🍎 Fruit Hub v7.8 (Точный хоп)"
    Title.TextColor3 = Color3.fromRGB(255, 215, 0)
    Title.BackgroundTransparency = 1
    Title.Font = Enum.Font.SourceSansBold
    Title.TextSize = 22

    local TabContainer = Instance.new("Frame")
    TabContainer.Parent = MainFrame
    TabContainer.Size = UDim2.new(1, -20, 1, -55)
    TabContainer.Position = UDim2.new(0, 10, 0, 45)
    TabContainer.BackgroundTransparency = 1
    print("5. Меню создано")

    local function AddButton(parent, text, callback, color)
        local btn = Instance.new("TextButton")
        btn.Parent = parent
        btn.Size = UDim2.new(1, 0, 0, 40)
        local count = #parent:GetChildren()
        btn.Position = UDim2.new(0, 0, 0, count * 44 + 5)
        btn.Text = text
        btn.BackgroundColor3 = color or Color3.fromRGB(60, 60, 85)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.SourceSans
        btn.TextSize = 17
        btn.BorderSizePixel = 0
        btn.BackgroundTransparency = 0.2
        local cornerBtn = Instance.new("UICorner")
        cornerBtn.Parent = btn
        cornerBtn.CornerRadius = UDim.new(0, 8)
        btn.MouseButton1Click:Connect(callback)
    end

    -- ========== HTTP-ЗАПРОСЫ ==========

    local function httpGet(url)
        local success, result = pcall(function() return http.request({ Url = url, Method = "GET" }) end)
        if success and result then return result.Body end
        local success2, result2 = pcall(function() return syn.request({ Url = url, Method = "GET" }) end)
        if success2 and result2 then return result2.Body end
        local success3, result3 = pcall(function() return game:HttpGet(url) end)
        if success3 and result3 then return result3 end
        return nil
    end

    local function getServers()
        local placeId = game.PlaceId
        local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?limit=100"
        local response = httpGet(url)
        if not response then
            Notify("❌ Не удалось получить список серверов")
            return nil
        end
        local success, data = pcall(function()
            return game:GetService("HttpService"):JSONDecode(response)
        end)
        if not success or not data or not data.data then
            Notify("❌ Ошибка парсинга")
            return nil
        end
        return data.data
    end

    local function getServerAge(server)
        local created = server.created
        if not created then return 0 end
        local now = os.time(os.date("!*t"))
        local year, month, day, hour, min, sec = created:match("(%d+)-(%d+)-(%d+)T(%d+):(%d+):(%d+)")
        if not year then return 0 end
        local timeTable = {year=year, month=month, day=day, hour=hour, min=min, sec=sec}
        local serverTime = os.time(timeTable)
        return os.difftime(now, serverTime)
    end

    -- ========== ПОИСК КНОПКИ КОНКРЕТНОГО СЕРВЕРА ==========

    local function findServerJoinButton(serverName)
        local playerGui = Player:WaitForChild("PlayerGui")
        -- Ищем контейнеры серверов. Обычно это Template или строки в ServerBrowser
        local serverContainers = {}

        -- Функция для поиска всех контейнеров, содержащих текст с именем сервера
        local function findContainers(parent)
            for _, child in pairs(parent:GetChildren()) do
                -- Проверяем, есть ли у child свойство Text и является ли оно строкой
                local hasText, text = pcall(function() return child.Text end)
                if hasText and type(text) == "string" and text ~= "" then
                    -- Если текст содержит имя сервера (или часть)
                    if string.find(text, serverName) then
                        -- Поднимаемся к контейнеру сервера (обычно это Template или Frame)
                        local container = child
                        while container and not (container.Name == "Template" or container.Name == "Inside" or container.Name == "ServerRow") do
                            container = container.Parent
                        end
                        if container then
                            table.insert(serverContainers, container)
                        end
                    end
                end
                -- Рекурсивно обходим детей
                findContainers(child)
            end
        end

        -- Начинаем поиск с PlayerGui
        findContainers(playerGui)

        -- Если нашли контейнеры, ищем внутри них кнопку Join
        for _, container in pairs(serverContainers) do
            for _, child in pairs(container:GetDescendants()) do
                if child:IsA("TextButton") or child:IsA("ImageButton") then
                    local hasText, text = pcall(function() return child.Text end)
                    if hasText and type(text) == "string" and (string.find(text, "Join") or string.find(text, "Играть")) then
                        return child
                    end
                end
            end
        end

        -- Если не нашли через контейнер, ищем любую кнопку Join (запасной вариант)
        for _, child in pairs(playerGui:GetDescendants()) do
            if child:IsA("TextButton") or child:IsA("ImageButton") then
                local hasText, text = pcall(function() return child.Text end)
                if hasText and type(text) == "string" and (string.find(text, "Join") or string.find(text, "Играть")) then
                    -- Проверим, есть ли рядом текст с именем сервера
                    local parent = child.Parent
                    for _, sibling in pairs(parent:GetChildren()) do
                        local hasSiblingText, siblingText = pcall(function() return sibling.Text end)
                        if hasSiblingText and type(siblingText) == "string" and string.find(siblingText, serverName) then
                            return child
                        end
                    end
                end
            end
        end

        return nil
    end

    -- ========== КЛИК ПО КНОПКЕ ==========

    local function clickButton(button)
        if not button then return false end
        pcall(function() button:Click() end)
        pcall(function()
            local pos = button.AbsolutePosition
            local size = button.AbsoluteSize
            if pos and size then
                local x = pos.X + size.X/2
                local y = pos.Y + size.Y/2
                mouse1click(x, y)
            end
        end)
        pcall(function()
            local vim = game:GetService("VirtualInputManager")
            if vim then
                vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                wait(0.1)
                vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end
        end)
        return true
    end

    -- ========== ХОП ==========

    local function hopToAge(targetHours)
        Notify("🔍 Ищем сервер с возрастом ~" .. targetHours .. " ч...")
        local servers = getServers()
        if not servers then return end

        local targetAge = targetHours * 3600
        local found = nil
        local bestDiff = math.huge
        local foundName = ""

        for _, server in pairs(servers) do
            local age = getServerAge(server)
            local diff = math.abs(age - targetAge)
            if diff < bestDiff then
                bestDiff = diff
                found = server
                foundName = server.name or server.id
            end
        end

        if not found then
            Notify("❌ Сервер с возрастом ~" .. targetHours .. "ч не найден")
            return
        end

        local age = getServerAge(found)
        local hours = math.floor(age / 3600)
        local minutes = math.floor((age % 3600) / 60)
        Notify("⏳ Найден сервер: " .. hours .. "ч " .. minutes .. "м. Ищем в меню...")

        -- Открываем меню (если необходимо)
        pcall(function()
            -- Если есть кнопка открытия меню, можно добавить
        end)

        wait(1.5)

        local serverButton = findServerJoinButton(foundName)
        if serverButton then
            Notify("✅ Найдена кнопка Join для этого сервера! Клик...")
            clickButton(serverButton)
            wait(1)
            Notify("✅ Клик выполнен.")
        else
            Notify("❌ Кнопка не найдена. Проверь консоль для отладки.")
            -- Выведем имя сервера для отладки
            print("Имя сервера для поиска:", foundName)
        end
    end

    -- ========== КНОПКИ ==========
    AddButton(TabContainer, "🕐 4 часа (04:00:00)", function() hopToAge(4) end, Color3.fromRGB(70, 130, 180))
    AddButton(TabContainer, "🕐 5 часов (05:00:00)", function() hopToAge(5) end, Color3.fromRGB(70, 130, 180))
    AddButton(TabContainer, "🕐 6 часов (06:00:00)", function() hopToAge(6) end, Color3.fromRGB(70, 130, 180))
    AddButton(TabContainer, "🕐 8 часов (08:00:00)", function() hopToAge(8) end, Color3.fromRGB(70, 130, 180))
    AddButton(TabContainer, "🕐 10 часов (10:00:00)", function() hopToAge(10) end, Color3.fromRGB(70, 130, 180))
    AddButton(TabContainer, "🕐 12 часов (12:00:00)", function() hopToAge(12) end, Color3.fromRGB(70, 130, 180))
    AddButton(TabContainer, "🔄 Перезапустить игру", function() game:Shutdown() end, Color3.fromRGB(200, 50, 50))

    print("6. Кнопки добавлены")

    local menuVisible = false
    toggleButton.MouseButton1Click:Connect(function()
        menuVisible = not menuVisible
        MainFrame.Visible = menuVisible
        print("Клик по кнопке, меню видимо =", menuVisible)
    end)

    print("7. Обработчик клика установлен")
end)

if not createSuccess then
    print("Ошибка при создании GUI:", createErr)
else
    print("✅ Fruit Hub v7.8 загружен! Нажми на 🍎")
end
