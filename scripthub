-- =============================================
--  BLOX HUB v3.4 (Точный возраст сервера + отладка)
-- =============================================

print("1. Скрипт начал выполнение")

local Player = game.Players.LocalPlayer
if not Player then
    print("Ошибка: Player не найден")
    return
end
print("2. Player найден")

local function Notify(text)
    print(text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Blox Hub",
            Text = text,
            Duration = 4
        })
    end)
end

local guiParent = Player:WaitForChild("PlayerGui")
if not guiParent then
    print("Ошибка: PlayerGui не найден")
    return
end
print("Используем PlayerGui")

wait(1)
print("3. Начинаем создание GUI")

local createSuccess, createErr = pcall(function()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "BloxHubGUI"
    screenGui.Parent = guiParent
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true
    print("3.1 ScreenGui создан")

    local toggleButton = Instance.new("ImageButton")
    toggleButton.Name = "ToggleButton"
    toggleButton.Parent = screenGui
    toggleButton.Size = UDim2.new(0, 80, 0, 80)
    toggleButton.Position = UDim2.new(0, 15, 0, 120)
    toggleButton.BackgroundColor3 = Color3.fromRGB(255, 220, 0)
    toggleButton.BackgroundTransparency = 0
    toggleButton.Image = "rbxassetid://1234567890"
    toggleButton.ImageTransparency = 1
    local corner = Instance.new("UICorner")
    corner.Parent = toggleButton
    corner.CornerRadius = UDim.new(1, 0)

    local label = Instance.new("TextLabel")
    label.Parent = toggleButton
    label.Size = UDim2.new(1, 0, 1, 0)
    label.Text = "⭐"
    label.TextScaled = true
    label.TextColor3 = Color3.fromRGB(0, 0, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.SourceSansBold
    print("4. Кнопка создана")

    local MainFrame = Instance.new("Frame")
    MainFrame.Parent = screenGui
    MainFrame.Size = UDim2.new(0, 480, 0, 580)
    MainFrame.Position = UDim2.new(0.5, -240, 0.5, -290)
    MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 35)
    MainFrame.BackgroundTransparency = 0.1
    MainFrame.Active = true
    MainFrame.Draggable = true
    MainFrame.Visible = false

    local cornerMain = Instance.new("UICorner")
    cornerMain.Parent = MainFrame
    cornerMain.CornerRadius = UDim.new(0, 16)

    local Title = Instance.new("TextLabel")
    Title.Parent = MainFrame
    Title.Size = UDim2.new(1, 0, 0, 45)
    Title.Text = "⭐ Blox Hub v3.4 (возраст сервера)"
    Title.TextColor3 = Color3.fromRGB(255, 215, 0)
    Title.BackgroundTransparency = 1
    Title.Font = Enum.Font.SourceSansBold
    Title.TextSize = 24

    local TabContainer = Instance.new("Frame")
    TabContainer.Parent = MainFrame
    TabContainer.Size = UDim2.new(1, -20, 1, -65)
    TabContainer.Position = UDim2.new(0, 10, 0, 55)
    TabContainer.BackgroundTransparency = 1
    print("5. Меню создано")

    local function AddButton(parent, text, callback, color)
        local btn = Instance.new("TextButton")
        btn.Parent = parent
        btn.Size = UDim2.new(1, 0, 0, 40)
        local count = #parent:GetChildren()
        btn.Position = UDim2.new(0, 0, 0, count * 44 + 5)
        btn.Text = text
        btn.BackgroundColor3 = color or Color3.fromRGB(60, 60, 85)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.SourceSans
        btn.TextSize = 16
        btn.BorderSizePixel = 0
        btn.BackgroundTransparency = 0.2
        local cornerBtn = Instance.new("UICorner")
        cornerBtn.Parent = btn
        cornerBtn.CornerRadius = UDim.new(0, 8)
        btn.MouseButton1Click:Connect(callback)
    end

    -- ========== ФУНКЦИЯ HTTP-ЗАПРОСА ==========

    local function httpGet(url)
        local success, result = pcall(function()
            return http.request({ Url = url, Method = "GET" })
        end)
        if success then return result.Body end

        local success2, result2 = pcall(function()
            return syn.request({ Url = url, Method = "GET" })
        end)
        if success2 then return result2.Body end

        return nil
    end

    -- ========== ТОЧНЫЙ РАСЧЁТ ВОЗРАСТА СЕРВЕРА (UTC) ==========

    local function getServerAge(server)
        local created = server.created
        if not created then return 0 end
        -- Текущее время в UTC
        local now = os.time(os.date("!*t"))
        -- Парсим created (формат ISO 8601)
        local year, month, day, hour, min, sec = created:match("(%d+)-(%d+)-(%d+)T(%d+):(%d+):(%d+)")
        if not year then return 0 end
        local timeTable = {year=year, month=month, day=day, hour=hour, min=min, sec=sec}
        local serverTime = os.time(timeTable)
        -- Возвращаем возраст в секундах
        return os.difftime(now, serverTime)
    end

    -- Получаем список серверов
    local function getServers()
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?limit=100"
        local response = httpGet(url)
        if not response then
            Notify("❌ Не удалось выполнить запрос.")
            return nil
        end
        local success, data = pcall(function()
            return game:GetService("HttpService"):JSONDecode(response)
        end)
        if not success then
            Notify("❌ Ошибка парсинга ответа")
            return nil
        end
        return data.data
    end

    -- ========== ОСНОВНАЯ ФУНКЦИЯ ХОПА ==========

    local function hopToServer()
        Notify("🔍 Поиск серверов с возрастом 50-59 минут...")
        local servers = getServers()
        if not servers then return end

        -- Проверяем текущий сервер
        local currentAge = workspace.DistributedGameTime
        local currentMin = math.floor((currentAge % 3600) / 60)
        if currentMin >= 50 and currentMin <= 59 then
            Notify("✅ Текущий сервер уже подходит (" .. currentMin .. " мин)")
            return
        end

        -- Ищем подходящий сервер
        local found = nil
        local foundMin = 0
        print("--- Список серверов (возраст в минутах) ---")
        for _, server in pairs(servers) do
            local age = getServerAge(server)
            local minutes = math.floor((age % 3600) / 60)
            print("Сервер:", server.id, "возраст (сек):", age, "минуты:", minutes)
            if minutes >= 50 and minutes <= 59 then
                found = server
                foundMin = minutes
                break
            end
        end

        if found then
            Notify("⏳ Найден сервер (" .. foundMin .. " мин). Телепорт...")
            game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, found.id, Player)
        else
            Notify("❌ Сервер в диапазоне 50-59 не найден. Попробуй позже.")
        end
    end

    -- ========== ОСТАЛЬНЫЕ ФУНКЦИИ ==========

    local function ShowServerTime()
        local seconds = workspace.DistributedGameTime
        local h = math.floor(seconds / 3600)
        local m = math.floor((seconds % 3600) / 60)
        local s = math.floor(seconds % 60)
        Notify(string.format("🕐 Возраст сервера: %02d:%02d:%02d", h, m, s))
    end

    -- Фарм, телепорты и т.д. (без изменений)
    local farming = false
    local farmCoroutine = nil

    local function StartFarm()
        if farming then return end
        farming = true
        farmCoroutine = coroutine.create(function()
            while farming do
                local char = Player.Character
                if not char then wait(1) break end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then wait(1) break end
                local mobs = {}
                for _, v in pairs(workspace:GetDescendants()) do
                    if v:IsA("Model") and v:FindFirstChild("Humanoid") and v.Name ~= Player.Name then
                        if v:FindFirstChild("HumanoidRootPart") then
                            table.insert(mobs, v)
                        end
                    end
                end
                if #mobs == 0 then wait(1)
                else
                    table.sort(mobs, function(a,b)
                        return (a.HumanoidRootPart.Position - hrp.Position).Magnitude < 
                               (b.HumanoidRootPart.Position - hrp.Position).Magnitude
                    end)
                    local target = mobs[1]
                    if target and target.Humanoid.Health > 0 then
                        hrp.CFrame = target.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                        wait(0.2)
                        pcall(function()
                            local VirtualInput = game:GetService("VirtualInputManager")
                            if VirtualInput then
                                VirtualInput:SendKeyEvent(true, "1", false, game)
                                wait(0.1)
                                VirtualInput:SendKeyEvent(false, "1", false, game)
                            end
                        end)
                    end
                end
                wait(0.5)
            end
        end)
        coroutine.resume(farmCoroutine)
        Notify("⚔️ Фарм включён")
    end

    local function StopFarm()
        farming = false
        Notify("⛔ Фарм остановлен")
    end

    local teleports = {
        ["Центр"] = Vector3.new(0, 10, 0),
        ["Остров джунглей"] = Vector3.new(1000, 10, 1000),
        ["Пляж"] = Vector3.new(-500, 10, 500),
    }

    local function TeleportTo(pos)
        local char = Player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = CFrame.new(pos)
            Notify("📍 Телепорт в " .. tostring(pos))
        else
            Notify("❌ Персонаж не найден")
        end
    end

    -- ========== КНОПКИ ==========
    AddButton(TabContainer, "🕐 Возраст сервера", ShowServerTime, Color3.fromRGB(70, 130, 180))
    AddButton(TabContainer, "🚀 Хоп на 50-59 мин (возраст)", hopToServer, Color3.fromRGB(0, 200, 100))
    AddButton(TabContainer, "⚔️ Включить фарм", StartFarm, Color3.fromRGB(200, 80, 80))
    AddButton(TabContainer, "⛔ Остановить фарм", StopFarm, Color3.fromRGB(80, 200, 80))
    for name, pos in pairs(teleports) do
        AddButton(TabContainer, "📍 " .. name, function() TeleportTo(pos) end, Color3.fromRGB(100, 150, 200))
    end

    print("6. Кнопки добавлены")

    local menuVisible = false
    toggleButton.MouseButton1Click:Connect(function()
        menuVisible = not menuVisible
        MainFrame.Visible = menuVisible
        print("Клик по кнопке, меню видимо =", menuVisible)
    end)

    print("7. Обработчик клика установлен")
end)

if not createSuccess then
    print("Ошибка при создании GUI:", createErr)
else
    print("✅ Blox Hub v3.4 успешно загружен! Нажми на жёлтую ⭐ для открытия меню.")
end
